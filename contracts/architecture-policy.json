{
  "version": 1,
  "packages": {
    "glade-binding-api": {
      "role": "contract",
      "dependencies": ["normal:glade-decl"],
      "traits": { "BindingResolver": ["resolve"] },
      "conformance_tests": ["public_contract"]
    },
    "glade-invocation-api": {
      "role": "contract",
      "dependencies": [],
      "traits": { "Invoker": ["invoke"] },
      "conformance_tests": ["public_contract"]
    },
    "glade-subscription-api": {
      "role": "contract",
      "dependencies": [],
      "traits": { "Subscriber": ["open"], "Subscription": ["next", "close"] },
      "conformance_tests": ["public_contract"]
    },
    "glade-sync-api": {
      "role": "contract",
      "dependencies": [],
      "traits": { "ReplicaSync": ["read", "ingest"] },
      "conformance_tests": ["public_contract"]
    },
    "glade-lifecycle-api": {
      "role": "contract",
      "dependencies": [],
      "traits": { "ManagedResource": ["phase", "shutdown"] },
      "conformance_tests": ["public_contract"]
    },
    "glade-persistence-api": {
      "role": "contract",
      "dependencies": [],
      "traits": { "SnapshotStore": ["load", "compare_exchange"] },
      "conformance_tests": ["public_contract"]
    },
    "glade-carrier-api": {
      "role": "contract",
      "dependencies": [],
      "traits": { "CarrierPort": ["bind", "dial", "accept", "close"], "CarrierLink": ["send", "recv", "close", "remote_id", "channel_binding"] },
      "conformance_tests": ["public_contract"]
    },
    "glade-clock-api": {
      "role": "contract",
      "dependencies": [],
      "traits": { "ClockPort": ["now_ms"] },
      "conformance_tests": ["public_contract"]
    },
    "glade-grant-api": {
      "role": "contract",
      "dependencies": [],
      "traits": { "GrantPort": ["check"] },
      "conformance_tests": ["public_contract"]
    },
    "glade-signer-api": {
      "role": "contract",
      "dependencies": [],
      "traits": { "SignerPort": ["node_id", "sign", "verify"] },
      "conformance_tests": ["public_contract"]
    },
    "glade-crdt-admission-core": {
      "role": "pure",
      "reason": "Deterministic admission/projection and effect issuance; owned data reexports; no I/O, clock, signing or concrete adapter.",
      "dependencies": [
        "normal:glade-wire",
        "normal:glade-crdt-admission-data",
        "normal:glade-crdt-storage-attempt-api",
        "dev:serde_json",
        "dev:syn"
      ],
      "conformance_tests": [
        "records_host_contract",
        "source_boundaries"
      ]
    },
    "glade-crdt-storage-attempt-api": {
      "role": "contract",
      "dependencies": ["normal:sha2", "dev:syn"],
      "traits": {
        "StorageAttemptHost": ["open"],
        "StorageAttemptSession": ["recover", "prepare", "recover_plan", "begin", "inspect", "request_fence", "close"]
      },
      "conformance_tests": ["public_contract", "source_boundaries"]
    },
    "glade-crdt-evidence-api": {
      "role": "contract",
      "dependencies": ["normal:glade-crdt-admission-data", "normal:glade-crdt-storage-attempt-api", "dev:syn"],
      "traits": {"EvidencePort": ["verify", "seal", "observe"]},
      "conformance_tests": ["public_contract", "source_boundaries"]
    },
    "glade-crdt-recovery-api": {
      "role": "contract",
      "dependencies": ["normal:glade-crdt-admission-data", "normal:glade-crdt-storage-attempt-api", "dev:syn"],
      "traits": {"ReplicaRecoveryHost": ["open_replica"], "ReplicaRecoverySession": ["load", "checkpoint", "begin_ingress", "receive_ingress", "settle_ingress", "abandon_ingress", "record_observation", "reconstruct_cut", "close"]},
      "conformance_tests": ["public_contract", "source_boundaries"]
    },
    "glade-crdt-recovery-codec": {
      "role": "protocol",
      "reason": "Bounded deterministic complete owned representation and unchanged IC2 batch decoding; no physical, proof, host or algorithm dependency.",
      "dependencies": ["normal:glade-crdt-admission-data", "normal:glade-crdt-storage-attempt-api", "normal:glade-wire", "dev:syn", "dev:serde_json"],
      "conformance_tests": ["roundtrip", "source_boundaries"]
    },
    "glade-crdt-admission-data": {
      "role": "protocol",
      "reason": "Owned canonical internal values and operation binding extracted from the Pure consumer; representation tests without I/O or substitution-marker traits.",
      "dependencies": [
        "normal:glade-wire",
        "normal:glade-crdt-storage-attempt-api",
        "dev:syn"
      ],
      "conformance_tests": [
        "representation",
        "source_boundaries"
      ]
    }
  }
}
